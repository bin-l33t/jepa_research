```python
class VectorFlow(nn.Module):
    """
    A simple MLP predictor.
    """
    def __init__(self, input_dim, hidden_dim, output_dim):
        super(VectorFlow, self).__init__()
        self.net = nn.Sequential(
            nn.Linear(input_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, hidden_dim),
            nn.ReLU(),
            nn.Linear(hidden_dim, output_dim)
        )

    def forward(self, x):
        return self.net(x)


class SIGRegLoss(nn.Module):
    """
    SIGRegLoss implementation.
    Regularizes embeddings using random projections.
    """
    def __init__(self, input_dim, proj_dim=128, target_std=1.0, eps=1e-6):
        super(SIGRegLoss, self).__init__()
        # Random projection matrix A
        self.register_buffer('A', torch.randn(input_dim, proj_dim))
        self.target_std = target_std
        self.eps = eps

    def forward(self, z):
        # CRITICAL MATH REQUIREMENT: Normalize A so columns have norm=1
        # A: [Input_Dim, Proj_Dim]
        norms = self.A.norm(dim=0, keepdim=True)
        A_norm = self.A / (norms + self.eps)

        # Project embeddings: P = Z @ A
        # z: [Batch, Input_Dim]
        proj = z @ A_norm

        # Calculate standard deviation of projections along the batch dimension
        # We encourage variance to be at least target_std to prevent collapse
        std_proj = torch.sqrt(proj.var(dim=0) + self.eps)
        
        # Hinge loss on standard deviation
        loss = torch.mean(torch.nn.functional.relu(self.target_std - std_proj))
        
        return loss
```
